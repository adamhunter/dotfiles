# Path to your oh-my-zsh configuration.
ZSH=$HOME/.oh-my-zsh

# Set name of the theme to load.
ZSH_THEME="sorin"

# Disable command autocorrection
DISABLE_CORRECTION="true"

# Plugins (custom/*.zsh files are sourced automatically by oh-my-zsh)
# macos is the only bundled plugin in use, and it's macOS-only — every function
# it defines shells out to open(1)/osascript, so it's skipped elsewhere.
plugins=()
[[ $OSTYPE == darwin* ]] && plugins+=(macos)

set -k

source $ZSH/oh-my-zsh.sh

source "$HOME/.zsh/exports.zsh"

# conda is lazy-loaded in custom/conda.zsh — the eager `conda init` block
# that used to live here cost ~1.6s of Python startup on every shell.

export PATH="$HOME/.local/bin:$PATH"

# fzf shell integration (ctrl-r history, ctrl-t file finder) — cached
_cached_eval fzf "${commands[fzf]}" fzf --zsh

# zoxide smart cd (use: z <directory>) — cached
_cached_eval zoxide "${commands[zoxide]}" zoxide init zsh

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
