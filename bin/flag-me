#!/usr/bin/env bash
# flag-me — raise a desktop banner saying which agent session needs me.
#
#   flag-me "one-line reason"   run by an agent when it's blocked on me
#   flag-me --hook              Claude Code Notification hook; reads the hook JSON on stdin
#
# Banner: title = Claude session name (falls back to the tmux window name),
# subtitle = "tmux-session › tmux-window", body = the reason.
# macOS only — terminal-notifier if installed, else osascript. Elsewhere it exits
# quietly. The reason lands in Notification Center: never put secrets, data
# values, or file contents in it.
set -uo pipefail

[[ "$(uname -s)" == Darwin ]] || exit 0

reason="" transcript=""
if [[ "${1:-}" == "--hook" ]]; then
  input=$(cat)
  reason=$(jq -r '.message // empty' <<<"$input" 2>/dev/null)
  transcript=$(jq -r '.transcript_path // empty' <<<"$input" 2>/dev/null)
else
  reason="$*"
  if [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
    shopt -s nullglob
    matches=("$HOME"/.claude/projects/*/"$CLAUDE_CODE_SESSION_ID".jsonl)
    transcript="${matches[0]:-}"
  fi
fi
reason="${reason:-Claude needs you}"
reason="${reason:0:200}"

# Claude session name = the latest /rename title recorded in the transcript.
# That file's format is internal to Claude Code and undocumented; if it changes,
# this finds nothing and the title falls back to the tmux window name.
name=""
if [[ -n "$transcript" && -r "$transcript" ]]; then
  name=$(grep -F '"type":"custom-title"' "$transcript" | tail -n 1 | jq -r '.customTitle // empty' 2>/dev/null)
fi

where=""
if [[ -n "${TMUX_PANE:-}" ]]; then
  where=$(tmux display-message -p -t "$TMUX_PANE" '#S › #W' 2>/dev/null)
fi

title="${name:-${where##* › }}"
title="${title:-Claude}"

if command -v terminal-notifier >/dev/null 2>&1; then
  terminal-notifier -title "$title" -subtitle "$where" -message "$reason" \
    -sound Glass -sender com.googlecode.iterm2 >/dev/null
else
  osascript - "$title" "$where" "$reason" >/dev/null <<'EOF'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv) sound name "Glass"
end run
EOF
fi
exit 0
